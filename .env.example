# Copy to .env and fill in. config.py auto-loads this file.

# ===== vLLM (OpenAI-compatible) — exactly the same as email_categorizer =====
VLLM_BASE_URL=https://internal-rnd.balitower.co.id/models/qwen35
VLLM_MODEL=gb10-qwen35-122b-nvfp4-4node-100k
VLLM_API_KEY=

# ===== Pexels (stock photo search) — sign up free at https://www.pexels.com/api/ =====
PEXELS_API_KEY=

# ===== Illustration tuning (optional) =====
# Length of each illustration segment (seconds). One picked image per segment.
ILLUSTRATOR_SEGMENT_SECONDS=5
# How many candidate images to offer per segment in the UI.
ILLUSTRATOR_CANDIDATES=4

# ===== Whisper STT (optional) =====
# Model: tiny|base|small|medium|large-v3. Empty = auto (medium on GPU, base on CPU).
# medium needs a GPU (torch build matching the CUDA driver) — see CLAUDE.md "Whisper / GPU".
# WHISPER_MODEL=medium
# Language: a code like "id". Empty = auto-detect. Indonesian content → set "id" for best results.
WHISPER_LANGUAGE=id

# ===== Vision model — AI auto-box (prompt → bounding box for the top crop) =====
# Leave empty to disable the auto-box feature (manual boxing still works).
VISION_BASE_URL=https://internal-rnd.balitower.co.id/models/qwen36-img
VISION_MODEL=qwen36-35b-a3b-nvfp4
# VISION_API_KEY=dummy

# ===== Encoder / download (optional) =====
# ILLUSTRATOR_ENCODER=libx264
# ILLUSTRATOR_COOKIES_BROWSER=firefox
