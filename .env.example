# Copy to .env and fill in. config.py auto-loads this file.

# ===== vLLM (OpenAI-compatible) — sama persis kaya email_categorizer =====
VLLM_BASE_URL=https://internal-rnd.balitower.co.id/models/qwen35
VLLM_MODEL=gb10-qwen35-122b-nvfp4-4node-100k
VLLM_API_KEY=

# ===== Pexels (stock photo search) — daftar gratis di https://www.pexels.com/api/ =====
PEXELS_API_KEY=

# ===== Illustration tuning (opsional) =====
# Panjang tiap segmen ilustrasi (detik). 1 gambar kepilih per segmen.
ILLUSTRATOR_SEGMENT_SECONDS=5
# Berapa kandidat gambar yang ditawarin per segmen di UI.
ILLUSTRATOR_CANDIDATES=4

# ===== Encoder / download (opsional) =====
# ILLUSTRATOR_ENCODER=libx264
# ILLUSTRATOR_COOKIES_BROWSER=firefox
